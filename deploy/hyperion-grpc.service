[Unit]
Description=Hyperion Mesh gRPC Gateway
After=network.target

[Service]
Type=simple
User=hyperion
Group=hyperion
WorkingDirectory=/opt/hyperion-mesh
Environment="RUST_LOG=info"
Environment="HYPERION_GRPC_ADDR=0.0.0.0:8080"
EnvironmentFile=-/opt/hyperion-mesh/.env
ExecStart=/opt/hyperion-mesh/bin/hyperion_grpc_server
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
