[Unit]
Description=Hyperion Mesh Card Webhook
After=network.target hyperion-grpc.service
Requires=hyperion-grpc.service

[Service]
Type=simple
User=hyperion
Group=hyperion
WorkingDirectory=/opt/hyperion-mesh
Environment="RUST_LOG=info"
Environment="HYPERION_CARD_WEBHOOK_ADDR=0.0.0.0:8082"
Environment="HYPERION_GRPC_UPSTREAM=http://127.0.0.1:8080"
EnvironmentFile=-/opt/hyperion-mesh/.env
ExecStart=/opt/hyperion-mesh/bin/hyperion_card_webhook
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
